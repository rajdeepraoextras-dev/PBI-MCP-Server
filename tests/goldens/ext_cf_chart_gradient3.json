{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "bar1",
  "position": {
    "x": 16,
    "y": 140,
    "z": 1,
    "width": 600,
    "height": 360,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "Date.Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Net Revenue"
                }
              },
              "queryRef": "Sales.Net Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue by Year'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "Sales"
                            }
                          },
                          "Property": "Margin %"
                        }
                      },
                      "FillRule": {
                        "linearGradient3": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#FFAC00'"
                              }
                            }
                          },
                          "mid": {
                            "color": {
                              "Literal": {
                                "Value": "'#FFFFFF'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0.5D"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#9B0065'"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'specificColor'"
                              }
                            },
                            "color": {
                              "Literal": {
                                "Value": "'#CCCCCC'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "Sales.Net Revenue"
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "Sales"
                        }
                      },
                      "Property": "Margin %"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "Sales.Net Revenue"
          }
        }
      ]
    }
  }
}
