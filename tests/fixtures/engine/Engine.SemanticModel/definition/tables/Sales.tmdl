table Sales
	lineageTag: 8f3c2a1e-6d4b-4c7a-9e21-0a5b7c3d9f01

	measure 'Total Amount' = SUM(Sales[Amount])
		formatString: #,0.00
		lineageTag: c1a2b3d4-0001-4e5f-8a9b-000000000001

	measure 'Order Count' = COUNTROWS(Sales)
		formatString: 0
		lineageTag: c1a2b3d4-0002-4e5f-8a9b-000000000002

	measure 'Average Amount' = DIVIDE([Total Amount], [Order Count])
		formatString: #,0.00
		lineageTag: c1a2b3d4-0003-4e5f-8a9b-000000000003

	column Id
		dataType: int64
		formatString: 0
		lineageTag: d1a2b3c4-0001-4e5f-8a9b-000000000011
