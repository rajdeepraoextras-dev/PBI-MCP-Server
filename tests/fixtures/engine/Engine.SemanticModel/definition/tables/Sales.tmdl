		formatString: 0
		lineageTag: d1a2b3c4-0003-4e5f-8a9b-000000000013
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = User

	column OrderDate
		dataType: dateTime
		lineageTag: d1a2b3c4-0004-4e5f-8a9b-000000000014
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: double
		lineageTag: d1a2b3c4-0005-4e5f-8a9b-000000000015
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

