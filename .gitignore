# Python
__pycache__/
*.py[cod]
.venv/
.venv-mcp2/
*.egg-info/
build/
dist/
!dist/
dist/*
!dist/pbi-mcp.plugin
# The ~20 MB standalone build is published as a GitHub Release asset, not tracked.
!dist/claude_desktop_config.snippet.json
.pytest_cache/

# PyInstaller
*.spec
/build/

# Local backups produced by io_safe
*.bak-*

# Keep fixtures dir but not local exports (add specific fixtures explicitly)
tests/fixtures/*
!tests/fixtures/.gitkeep
# Synthetic fixture is generated + safe to commit; real Sample.pbip stays local
!tests/fixtures/synthetic/
tests/fixtures/synthetic/**/.pbi/
